{
	"info": {
		"name": "Meeting Scheduler API (Local)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Login (Get Token)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"pm.environment.set(\"token\", jsonData.data.token);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"asha@corp.com\",\n    \"password\": \"user123\"\n}"
				},
				"url": {
					"raw": "http://localhost:5000/api/v1/auth/login",
					"protocol": "http",
					"host": ["localhost"],
					"port": "5000",
					"path": ["api", "v1", "auth", "login"]
				}
			}
		},
		{
			"name": "2. Get All Rooms",
			"request": {
				"method": "GET",
				"header": [
					{ "key": "Authorization", "value": "Bearer {{token}}" }
				],
				"url": {
					"raw": "http://localhost:5000/api/v1/rooms",
					"protocol": "http",
					"host": ["localhost"],
					"port": "5000",
					"path": ["api", "v1", "rooms"]
				}
			}
		},
		{
			"name": "3. Book Meeting A (Valid)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if(jsonData.data && jsonData.data.meetingId) { pm.environment.set(\"meetingA_id\", jsonData.data.meetingId); }"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Content-Type", "value": "application/json" },
					{ "key": "Authorization", "value": "Bearer {{token}}" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"title\": \"Meeting A\",\n    \"roomId\": 1,\n    \"startTime\": \"2026-10-15 10:00:00\",\n    \"endTime\": \"2026-10-15 11:00:00\",\n    \"attendees\": 4,\n    \"participantIds\": [3, 4]\n}"
				},
				"url": {
					"raw": "http://localhost:5000/api/v1/meetings",
					"protocol": "http",
					"host": ["localhost"],
					"port": "5000",
					"path": ["api", "v1", "meetings"]
				}
			}
		},
		{
			"name": "4. Book Meeting B (Conflict - Expect 409)",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Content-Type", "value": "application/json" },
					{ "key": "Authorization", "value": "Bearer {{token}}" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"title\": \"Meeting B (Overlap)\",\n    \"roomId\": 1,\n    \"startTime\": \"2026-10-15 10:30:00\",\n    \"endTime\": \"2026-10-15 11:30:00\",\n    \"attendees\": 4,\n    \"participantIds\": []\n}"
				},
				"url": {
					"raw": "http://localhost:5000/api/v1/meetings",
					"protocol": "http",
					"host": ["localhost"],
					"port": "5000",
					"path": ["api", "v1", "meetings"]
				}
			}
		},
		{
			"name": "5. Cancel Meeting A",
			"request": {
				"method": "PATCH",
				"header": [
					{ "key": "Content-Type", "value": "application/json" },
					{ "key": "Authorization", "value": "Bearer {{token}}" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"reason\": \"Cancelled for testing\"\n}"
				},
				"url": {
					"raw": "http://localhost:5000/api/v1/meetings/{{meetingA_id}}/cancel",
					"protocol": "http",
					"host": ["localhost"],
					"port": "5000",
					"path": ["api", "v1", "meetings", "{{meetingA_id}}", "cancel"]
				}
			}
		},
		{
			"name": "6. Re-Book Meeting B (Now Valid)",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Content-Type", "value": "application/json" },
					{ "key": "Authorization", "value": "Bearer {{token}}" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"title\": \"Meeting B (Overlap Resolved)\",\n    \"roomId\": 1,\n    \"startTime\": \"2026-10-15 10:30:00\",\n    \"endTime\": \"2026-10-15 11:30:00\",\n    \"attendees\": 4,\n    \"participantIds\": []\n}"
				},
				"url": {
					"raw": "http://localhost:5000/api/v1/meetings",
					"protocol": "http",
					"host": ["localhost"],
					"port": "5000",
					"path": ["api", "v1", "meetings"]
				}
			}
		},
        {
			"name": "7. RoomBot Message",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Content-Type", "value": "application/json" },
					{ "key": "Authorization", "value": "Bearer {{token}}" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"sessionId\": \"demo-chat-123\",\n    \"text\": \"Book a room tomorrow at 3pm for 5 people\"\n}"
				},
				"url": {
					"raw": "http://localhost:5000/api/v1/roombot/message",
					"protocol": "http",
					"host": ["localhost"],
					"port": "5000",
					"path": ["api", "v1", "roombot", "message"]
				}
			}
		}
	]
}
